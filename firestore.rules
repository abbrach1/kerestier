rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Organizers are listed in the `admins` collection, one doc per Google email.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Either a passport photo was uploaded, or the details were typed in.
    function validPhoto(d, id) {
      return d.method == 'photo'
          && d.nationality == '' && d.passportNumber == '' && d.passportExpiry == '' && d.birthDate == ''
          && d.passportFileName.matches('passport-[0-9]+[.][a-z0-9]{2,5}')
          && d.passportFilePath == 'passports/' + id + '/' + d.passportFileName;
    }
    function validManual(d) {
      return d.method == 'manual'
          && d.nationality.size() > 0
          && d.passportNumber.matches('[A-Z0-9]{5,20}')
          && d.passportExpiry.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.passportFilePath == '';
    }

    // The public form can only create. Only admins can read; nobody can edit or
    // delete from the browser.
    match /tripRegistrations/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if validRegistration(request.resource.data, id);
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Every field is required (empty strings for unused ones), typed and size-capped,
    // so the public form can't be used to store junk or oversized data.
    function validRegistration(d, id) {
      return d.keys().hasOnly(FIELDS()) && d.keys().hasAll(FIELDS())
          && str(d.firstName, 1, 80)
          && str(d.middleName, 0, 80)
          && str(d.lastName, 1, 80)
          && str(d.birthDate, 0, 10)
          && str(d.matmidNumber, 0, 12) && d.matmidNumber.matches('[0-9]*')
          && str(d.trip, 1, 60)
          && str(d.passportFileName, 0, 60)
          && str(d.passportFilePath, 0, 120)
          && str(d.nationality, 0, 60)
          && str(d.passportNumber, 0, 20)
          && str(d.passportExpiry, 0, 10)
          && d.createdAt == request.time
          && (validPhoto(d, id) || validManual(d));
    }

    function FIELDS() {
      return ['firstName', 'middleName', 'lastName', 'birthDate', 'method',
              'nationality', 'passportNumber', 'passportExpiry', 'matmidNumber',
              'passportFilePath', 'passportFileName', 'trip', 'createdAt'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
