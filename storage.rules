rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only these types: no SVG or HTML, which could carry scripts.
    function allowedType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
          || request.resource.contentType == 'application/pdf';
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Anyone can upload; only admins (see firestore.rules) can view or delete.
    // Nothing can be overwritten.
    match /passports/{submissionId}/{fileName} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && submissionId.matches('[A-Za-z0-9]{20}')
                    && fileName.matches('passport-[0-9]+[.][a-z0-9]{2,5}')
                    && allowedType();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
