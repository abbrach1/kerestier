# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Values come from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Server-only (Vercel env vars, NOT prefixed with VITE_) ----
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender on a domain you've verified in Resend, e.g. "YTC Trips <trips@ytchaim.com>".
# For a quick test before verifying a domain you can use: onboarding@resend.dev
NOTIFY_FROM=
# Who gets the alert. Comma-separate multiple addresses.
NOTIFY_TO=
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
# Optional: your public site URL, used for the link in the email.
SITE_URL=
